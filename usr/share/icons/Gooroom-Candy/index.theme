[Icon Theme]
Name=Gooroom Candy
Comment=Gooroom icon theme based on Candy icons (https://github.com/EliverLara/candy-icons, GPL-3.0)
Inherits=Fluent-dark,hicolor

# Directory list
Directories=places/16,places/48,apps/scalable,devices/scalable,preferences/scalable,mimetypes/scalable,status/scalable,categories/scalable

[apps/scalable]
Size=96
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[devices/scalable]
Size=96
Context=Devices
MinSize=8
MaxSize=512
Type=Scalable

[preferences/scalable]
Size=96
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[mimetypes/scalable]
Size=96
Context=MimeTypes
MinSize=8
MaxSize=256
Type=Scalable

[places/16]
Size=16
Context=Places
MinSize=8
MaxSize=32
Type=Scalable

[places/48]
Size=48
Context=Places
MinSize=8
MaxSize=512
Type=Scalable

[status/scalable]
Size=64
Context=Status
MinSize=16
MaxSize=128
Type=Scalable

[categories/scalable]
Size=48
Context=Categories
MinSize=8
MaxSize=512
Type=Scalable
